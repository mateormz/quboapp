  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"Identifica los n\xFAmeros que tienes que sumar: 1 y 4.\",\r\n\"Empieza
    con el primer n\xFAmero, que es 1.\",\r\n\"Cuenta hacia adelante sumando el siguiente
    n\xFAmero (4).\",\r\n\"Puedes usar tus dedos o una recta num\xE9rica para ayudarte:
    comienza en 1 y cuenta cuatro veces m\xE1s.\",\r\n\"Observa en qu\xE9 n\xFAmero
    terminas despu\xE9s de contar.\"\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: ff76023c9af2f9f469911fe447618402, type: 2}
  m_sharedMaterial: {fileID: -2951573836657292315, guid: ff76023c9af2f9f469911fe447618402, type: 2}
